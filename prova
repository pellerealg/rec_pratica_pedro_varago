SELECT
    c.endereco_wallet,
    c.rede_blockchain,
    c.saldo_usd,
    i.nome AS nome_investidor,
    i.cpf
FROM carteira c
INNER JOIN investidore i ON c.investidor_id = i.id
WHERE c.status IN ('Ativa', 'Em Analise');

SELECT
    co.nome_exchange,
    SUM(tc.valor_pago) AS valor_total_movimentado
FROM transacoes_criptos tc
INNER JOIN criptomoedas cr ON tc.criptomoeda_id = cr.id
INNER JOIN corretoras co ON cr.corretora_id = co.id
GROUP BY co.id, co.nome_exchange;

SELECT
    c.endereco_wallet,
    cr.nome_moeda,
    tc.quantidade,
    tc.valor_pago,
    tc.data_transacao
FROM transacoes_criptos tc
INNER JOIN carteira c ON tc.carteira_id = c.id
INNER JOIN criptomoedas cr ON tc.criptomoeda_id = cr.id
WHERE tc.valor_pago > 500.00
ORDER BY tc.valor_pago DESC;

CREATE OR REPLACE VIEW vw_painel_carteira AS
SELECT
    c.endereco_wallet,
    c.rede_blockchain,
    c.status,
    c.saldo_usd,
    i.nome AS nome_investidor,
    i.cpf
FROM carteira c
INNER JOIN investidore i ON c.investidor_id = i.id;

CREATE OR REPLACE VIEW vw_investimento_total_carteira AS
SELECT
    c.id AS carteira_id,
    c.endereco_wallet,
    c.saldo_usd,
    COUNT(tc.id) AS total_transacoes,
    COALESCE(SUM(tc.valor_pago), 0.00) AS custo_total_compras
FROM carteira c
LEFT JOIN transacoes_cripto tc ON c.id = tc.carteira_id
GROUP BY c.id, c.endereco_wallet, c.saldo_usd;

