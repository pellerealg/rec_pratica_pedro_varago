CREATE TABLE investidore (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf VARCHAR(11) NOT NULL UNIQUE,
    nivel_experiencia INT NOT NULL DEFAULT 0,
    CONSTRAINT chk_cpf_tamanho CHECK (CHAR_LENGTH(cpf) = 11),
    CONSTRAINT chk_nivel_experiencia CHECK (nivel_experiencia >= 0)
);

CREATE TABLE carteira (
    id SERIAL PRIMARY KEY,
    investidor_id INT NOT NULL,
    endereco_wallet VARCHAR(120) NOT NULL UNIQUE,
    rede_blockchain VARCHAR(50) NOT NULL,
    saldo_usd DECIMAL(10, 2) NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'Ativa',
    CONSTRAINT fk_carteiras_investidor FOREIGN KEY (investidor_id) REFERENCES investidore(id),
    CONSTRAINT chk_saldo_usd CHECK (saldo_usd > 0),
    CONSTRAINT chk_status_carteira CHECK (status IN ('Ativa', 'Em Analise', 'Bloqueada', 'Pausada'))
);

CREATE TABLE corretoras (
    id SERIAL PRIMARY KEY,
    nome_exchange VARCHAR(100) NOT NULL,
    cnpj VARCHAR(14) NOT NULL UNIQUE,
    email_suporte VARCHAR(100) NOT NULL UNIQUE,
    CONSTRAINT chk_cnpj_tamanho CHECK (CHAR_LENGTH(cnpj) = 14)
);

CREATE TABLE criptomoedas (
    id SERIAL PRIMARY KEY,
    corretora_id INT NOT NULL,
    nome_moeda VARCHAR(60) NOT NULL,
    preco_unitario_usd DECIMAL(10, 2) NOT NULL,
    categoria VARCHAR(20) NOT NULL DEFAULT 'Layer1',
    CONSTRAINT fk_criptomoedas_corretora FOREIGN KEY (corretora_id) REFERENCES corretoras(id),
    CONSTRAINT chk_preco_unitario CHECK (preco_unitario_usd > 0),
    CONSTRAINT chk_categoria_moeda CHECK (categoria IN ('Layer1', 'DeFi', 'Memecoin', 'Stablecoin'))
);

CREATE TABLE transacoes_criptos (
    id SERIAL PRIMARY KEY,
    carteira_id INT NOT NULL,
    criptomoeda_id INT NOT NULL,
    quantidade DECIMAL(18, 8) NOT NULL,
    valor_pago DECIMAL(15, 2) NOT NULL,
    data_transacao TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_transacoes_carteira FOREIGN KEY (carteira_id) REFERENCES carteira(id),
    CONSTRAINT fk_transacoes_criptomoeda FOREIGN KEY (criptomoeda_id) REFERENCES criptomoedas(id),
    CONSTRAINT chk_quantidade CHECK (quantidade > 0),
    CONSTRAINT chk_valor_pago CHECK (valor_pago > 0)
);

